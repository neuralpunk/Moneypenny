{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moneypenny",
  "version": "0.1.0",
  "identifier": "io.github.neuralpunk.Moneypenny",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Moneypenny",
        "width": 960,
        "height": 640,
        "minWidth": 360,
        "minHeight": 294,
        "decorations": false,
        "transparent": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm"
    ],
    "category": "Utility",
    "shortDescription": "Manage the passwords and secrets in your keyrings",
    "longDescription": "Moneypenny is a GNOME-style manager for the passwords and secrets that apps store in your keyrings, built for the oo7 Secret Service.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "linux": {
      "rpm": {
        "release": "1",
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ],
        "recommends": [
          "oo7-daemon"
        ],
        "desktopTemplate": "../packaging/moneypenny.desktop.hbs",
        "files": {
          "/usr/share/metainfo/io.github.neuralpunk.Moneypenny.metainfo.xml": "../packaging/io.github.neuralpunk.Moneypenny.metainfo.xml",
          "/usr/share/icons/hicolor/scalable/apps/moneypenny.svg": "icons/moneypenny.svg",
          "/usr/share/licenses/moneypenny/LICENSE": "../LICENSE"
        }
      }
    }
  }
}
